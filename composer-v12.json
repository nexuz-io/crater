{
  "name": "crater-invoice/crater",
  "description": "Free & Open Source Invoice App for Individuals & Small Businesses. https://craterapp.com",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "aws/aws-sdk-php": "^3.142",
    "barryvdh/laravel-dompdf": "^2.0|^3.0",
    "crater-invoice/modules": "^1.0.0",
    "doctrine/dbal": "^3.0|^4.0",
    "dragonmantank/cron-expression": "^3.1",
    "guzzlehttp/guzzle": "^7.0.1",
    "intervention/image": "^3.0",
    "jasonmccreary/laravel-test-assertions": "^2.0|^3.0",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^3.0|^4.0",
    "laravel/tinker": "^2.7|^2.8",
    "lavary/laravel-menu": "^1.8",
    "league/flysystem-aws-s3-v3": "^3.0",
    "predis/predis": "^1.1|^2.0",
    "silber/bouncer": "^1.0|^2.0",
    "spatie/flysystem-dropbox": "^2.0|^3.0",
    "spatie/laravel-backup": "^7.0|^8.0|^9.0",
    "spatie/laravel-medialibrary": "^9.0|^10.0|^11.0",
    "vinkla/hashids": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^2.6|^3.0",
    "spatie/laravel-ignition": "^1.0|^2.0",
    "friendsofphp/php-cs-fixer": "^3.8",
    "fakerphp/faker": "^1.9.1",
    "mockery/mockery": "^1.3.1",
    "nunomaduro/collision": "^8.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-faker": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Crater\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Modules\\": "Modules/"
    },
    "files": [
      "app/Space/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": [
          "dompdf/dompdf"
        ]
      }
    },
    "platform": {
      "php": "8.4.99"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  }
}
