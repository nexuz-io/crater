!storage/fonts/.gitkeep
# Generated PDF font assets (TTF/UFM/JSON catalog). Produced on demand by
# the Snappy/DOMPDF font helper. Each install rebuilds them locally.
/storage/fonts/*.ttf
/storage/fonts/*.ufm
/storage/fonts/*.ufm.json
/storage/fonts/installed-fonts.json

# Local agent workspace. The folder itself IS tracked (README, TEMPLATE,
# HOWTO-*, and individual plans/<NN>-*.md are shared documentation) but
# the per-developer working artifacts inside are not.
#
# Shared, tracked:  /agents/{README,TEMPLATE,HOWTO-*}.md
#                   /agents/plans/<NN>-<topic>.md       (1 plan per objective)
#
# Personal, ignored:  audit-* / build-csv.js / emit-md.js / apply-*-js
#                     inside .agents/plans/ are scratch tooling and never
#                     land in the repo.
# Per-developer working artifacts inside .agents/plans/ stay local:
# audit-*, build-csv.js, emit-md.js, apply-items-terms.js, etc.
# Anything not matching these is treated as shared docs and is tracked.
# (Listed individually because gitignore doesn't expand `*.{js,csv}`.)
/.agents/plans/audit-items.csv
/.agents/plans/audit-items.js
/.agents/plans/audit-items.json
/.agents/plans/audit-items.md
/.agents/plans/audit-items2.js
/.agents/plans/audit-presence.csv
/.agents/plans/build-csv.js
/.agents/plans/emit-md.js
/.agents/plans/apply-items-terms.js
/.agents/plans/apply-*.js
.DS_Store

# Frontend assets are built in CI and uploaded to the droplet
/public/build

# IDE helper files generated by barryvdh/laravel-ide-helper
# Each developer runs `php artisan ide-helper:generate` locally.
_ide_helper.php
.phpstorm.meta.php

# Psy/psysh scratch files: tinker drops them in cwd when an
# expression fails to parse (e.g. `pluck(key))`). Safe to ignore.
pluck(*)
